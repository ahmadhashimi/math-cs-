# Server-side only — powers the "Explain it my way" tutor and written-answer
# marking. Everything else in the course works without a key; the two AI panels
# report themselves unconfigured.
#
# Set ONE of these. If both are set, AI_PROVIDER decides.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. "anthropic" (default) or "openai" — only needed when both keys are
# present and you want to pin which one runs.
AI_PROVIDER=

# Optional. Overrides the OpenAI model; defaults to gpt-4o-mini.
OPENAI_MODEL=
